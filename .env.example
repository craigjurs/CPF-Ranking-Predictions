# This file is safe to commit: it holds POINTERS to secrets, never secret values.
# The CFBD API key itself lives in your vault. See docs/security/setup-your-key.md.

# Which vault the MCP server asks: auto | network_secret | onepassword | bitwarden | keychain
# auto = network_secret in Claude cloud sessions, onepassword on your own laptop
CFBD_SECRET_PROVIDER=auto

# Where in that vault the key lives.
#   1Password: op://<vault>/<item>/<field>
#   Bitwarden: <secret UUID>
#   Keychain:  <service>/<username>
CFBD_SECRET_REF=op://cfbd-agent/CFBD API/credential
